<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="MauiApp1.Views.AddEditInvestmentPage"
             xmlns:local="clr-namespace:MauiApp1.ViewModels"
             x:DataType="local:AddEditInvestmentViewModel"
             Title="Add/Edit Investment">

    <StackLayout Padding="10">

        <Entry Text="{Binding Investment.Name}" Placeholder="Investment Name" />
        <Entry Text="{Binding Investment.InitialValue}" Placeholder="Initial Value" Keyboard="Numeric" />
        <Entry Text="{Binding Investment.CurrentValue}" Placeholder="Current Value" Keyboard="Numeric" />
        <DatePicker Date="{Binding Investment.DateAcquired}" />

        <Button Text="Save"
                Command="{Binding SaveCommand}" />
        <Button Text="Cancel"
                Command="{Binding CancelCommand}" />
    </StackLayout>

</ContentPage>