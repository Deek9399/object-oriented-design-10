<Shell
    x:Class="MauiApp1.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:MauiApp1.Views"
    Shell.FlyoutBehavior="Flyout"
    Title="MauiApp1">

    <!-- Main page for home -->
    <ShellContent
        Title="Home"
        ContentTemplate="{DataTemplate views:MainPage}"
        Route="MainPage" />

    <!-- Login page navigation -->
    <ShellContent
        Title="Login"
        ContentTemplate="{DataTemplate views:LoginPage}"
        Route="LoginPage" />

    <!-- Create User (Account) page navigation -->
    <ShellContent
        Title="Create Account"
        ContentTemplate="{DataTemplate views:CreateUserPageView}"
        Route="CreateUserPageView" />
    
    <!-- User Dashboard page navigation -->
    <ShellContent
        Title="Dashboard"
        ContentTemplate="{DataTemplate views:UserDashboardPage}"
        Route="UserDashboardPage" />
</Shell>