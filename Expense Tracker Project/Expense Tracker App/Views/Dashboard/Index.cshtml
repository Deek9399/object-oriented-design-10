    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{
    ViewData["isDashboard"] = true;
}

<div class="dashboard-container">
    @*Summary Widgets*@
    <div class="dashboard-section">
        <h5 class="dashboard-section-title">Financial Overview</h5>
        <div class="row">
            <div class="col-md-3">
                <div class="d-flex flex-row widget summary income">
                    <div class="d-flex flex-column justify-content-center">
                        <i class="fa-solid fa-arrow-trend-up fa-2xl"></i>
                    </div>
                    <div class="d-flex flex-column m-auto py-3">
                        <span class="lead">Total Income</span>
                        <h1 class="display-6 fw-bold">@ViewBag.TotalIncome</h1>
                    </div>
                </div>
            </div>

            <div class="col-md-3">
                <div class="d-flex flex-row widget summary expense">
                    <div class="d-flex flex-column justify-content-center">
                        <i class="fa-solid fa-arrow-trend-down fa-2xl"></i>
                    </div>
                    <div class="d-flex flex-column m-auto py-3">
                        <span class="lead">Total Expense</span>
                        <h1 class="display-6 fw-bold">@ViewBag.TotalExpense</h1>
                    </div>
                </div>
            </div>

            <div class="col-md-3">
                <div class="d-flex flex-row widget summary balance">
                    <div class="d-flex flex-column justify-content-center">
                        <i class="fa-solid fa-wallet fa-2xl"></i>
                    </div>
                    <div class="d-flex flex-column m-auto py-3">
                        <span class="lead">Balance</span>
                        <h1 class="display-6 fw-bold">@ViewBag.Balance</h1>
                    </div>
                </div>
            </div>

            <div class="col-md-3">
                <div class="d-flex flex-row widget summary budget">
                    <div class="d-flex flex-column justify-content-center">
                        <i class="fa-solid fa-sack-dollar fa-2xl"></i>
                    </div>
                    <div class="d-flex flex-column m-auto py-3">
                        <span class="lead">Budget Status</span>
                        @if (ViewBag.BudgetAmount > 0)
                        {
                            <div class="d-flex flex-column">
                                <h1 class="display-6 fw-bold">@ViewBag.Budget</h1>
                                @{
                                    var budgetAmount = ViewBag.BudgetAmount;
                                    var totalExpenseAmount = ViewBag.TotalExpenseAmount;
                                    var budgetStatus = budgetAmount > 0 && totalExpenseAmount > budgetAmount ? "Over Budget" : "Within Budget";
                                    var budgetClass = budgetStatus == "Over Budget" ? "text-danger" : "text-success";
                                }
                                <div class="@budgetClass">@budgetStatus</div>
                            </div>
                        }
                        else
                        {
                            <div class="d-flex align-items-center">
                                <a href="/Budget" class="btn btn-success">Set Budget</a>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>

    @*Bar Charts Section*@
    <div class="dashboard-section">
        <h5 class="dashboard-section-title">Detailed Analysis</h5>
        <div class="row">
            <div class="col-md-6">
                <div class="widget chart">
                    <h5>Category Expense Comparison</h5>
                    <ejs-chart id="category-bar-chart" background="transparent"
                               palettes=@(new string[]{"#4f46e5","#10b981","#3b82f6","#f59e0b","#ef4444"})>
                        <e-chart-primaryxaxis valueType="Category">
                            <e-majorgridlines width="0"></e-majorgridlines>
                            <e-majorticklines width="0"></e-majorticklines>
                            <e-linestyle width="0"></e-linestyle>
                            <e-labelstyle color="#354f75"></e-labelstyle>
                        </e-chart-primaryxaxis>
                        <e-chart-primaryyaxis>
                            <e-majorgridlines width="1" color="#e2e8f0" dashArray="3,5"></e-majorgridlines>
                            <e-majorticklines width="0"></e-majorticklines>
                            <e-linestyle width="0"></e-linestyle>
                            <e-labelstyle color="#354f75"></e-labelstyle>
                        </e-chart-primaryyaxis>
                        <e-chart-chartarea>
                            <e-chartarea-border width="0"></e-chartarea-border>
                        </e-chart-chartarea>
                        <e-series-collection>
                            <e-series dataSource="@ViewBag.CategoryBarChartData" xName="category" yName="amount" 
                                      name="Expense" type="@Syncfusion.EJ2.Charts.ChartSeriesType.Column">
                                <e-series-marker visible="true" width="8" height="8" shape="Circle"></e-series-marker>
                            </e-series>
                        </e-series-collection>
                        <e-chart-legendsettings position="Top" toggleVisibility="false">
                            <e-legendsettings-textstyle color="#1e293b" size="1rem"></e-legendsettings-textstyle>
                        </e-chart-legendsettings>
                        <e-chart-tooltipsettings enable></e-chart-tooltipsettings>
                    </ejs-chart>
                </div>
            </div>
            <div class="col-md-6">
                <div class="widget chart">
                    <h5>Daily Income & Expense</h5>
                    <ejs-chart id="stacked-bar-chart" background="transparent"
                               palettes=@(new string[]{"#10b981","#ef4444"})>
                        <e-chart-primaryxaxis valueType="Category">
                            <e-majorgridlines width="0"></e-majorgridlines>
                            <e-majorticklines width="0"></e-majorticklines>
                            <e-linestyle width="0"></e-linestyle>
                            <e-labelstyle color="#354f75"></e-labelstyle>
                        </e-chart-primaryxaxis>
                        <e-chart-primaryyaxis>
                            <e-majorgridlines width="1" color="#e2e8f0" dashArray="3,5"></e-majorgridlines>
                            <e-majorticklines width="0"></e-majorticklines>
                            <e-linestyle width="0"></e-linestyle>
                            <e-labelstyle color="#354f75"></e-labelstyle>
                        </e-chart-primaryyaxis>
                        <e-chart-chartarea>
                            <e-chartarea-border width="0"></e-chartarea-border>
                        </e-chart-chartarea>
                        <e-series-collection>
                            <e-series dataSource="@ViewBag.StackedBarChartData" xName="day" yName="income" 
                                      name="Income" type="@Syncfusion.EJ2.Charts.ChartSeriesType.StackingColumn">
                            </e-series>
                            <e-series dataSource="@ViewBag.StackedBarChartData" xName="day" yName="expense" 
                                      name="Expense" type="@Syncfusion.EJ2.Charts.ChartSeriesType.StackingColumn">
                            </e-series>
                        </e-series-collection>
                        <e-chart-legendsettings visible="true" position="Top">
                            <e-legendsettings-textstyle color="#354f75" size="14px"></e-legendsettings-textstyle>
                        </e-chart-legendsettings>
                        <e-chart-tooltipsettings enable="true" fill="#ffffff" opacity="1" shared="false" enableAnimation="true">
                            <e-tooltipsettings-textstyle color="#354f75" size="14px"></e-tooltipsettings-textstyle>
                            <e-tooltipsettings-border color="#e2e8f0" width="1"></e-tooltipsettings-border>
                        </e-chart-tooltipsettings>
                    </ejs-chart>
                </div>
            </div>
        </div>
    </div>

    @*Charts Section*@
    <div class="dashboard-section">
        <h5 class="dashboard-section-title">Financial Analytics</h5>
        <div class="row">
            <div class="col-md-4">
                <div class="widget chart">
                    <h5>Expense By Category</h5>
                    <ejs-accumulationchart id="doughnutchart" enableSmartLabels background="transparent">
                        <e-accumulation-series-collection>
                            <e-accumulation-series dataSource="@ViewBag.DoughnutChartData"
                                               xName="categoryTitleWithIcon" yName="amount"
                                               innerRadius="60%" legendShape="Circle" 
                                               palettes=@(new string[]{"#4f46e5","#10b981","#3b82f6","#f59e0b","#ef4444","#8b5cf6","#ec4899","#14b8a6","#f97316","#06b6d4"})>
                                <e-accumulationseries-datalabel name="formattedAmount" visible></e-accumulationseries-datalabel>
                            </e-accumulation-series>
                        </e-accumulation-series-collection>
                        <e-accumulationchart-legendsettings position="Top" toggleVisibility="false">
                            <e-legendsettings-textstyle color="#1e293b" size="1rem"></e-legendsettings-textstyle>
                        </e-accumulationchart-legendsettings>
                        <e-accumulationchart-tooltipsettings enable></e-accumulationchart-tooltipsettings>
                    </ejs-accumulationchart>
                </div>
            </div>
            <div class="col-md-8">
                <div class="widget chart">
                    <h5>Income vs Expense</h5>
                    <ejs-chart id="spline-chart" background="transparent"
                               palettes=@(new string[]{"#10b981","#ef4444"})>
                        <e-chart-primaryxaxis valueType="Category">
                            <e-majorgridlines width="0"></e-majorgridlines>
                            <e-majorticklines width="0"></e-majorticklines>
                            <e-linestyle width="0"></e-linestyle>
                            <e-labelstyle color="#64748b"></e-labelstyle>
                        </e-chart-primaryxaxis>
                        <e-chart-primaryyaxis>
                            <e-majorgridlines width="1" color="#e2e8f0" dashArray="3,5"></e-majorgridlines>
                            <e-majorticklines width="0"></e-majorticklines>
                            <e-linestyle width="0"></e-linestyle>
                            <e-labelstyle color="#64748b"></e-labelstyle>
                        </e-chart-primaryyaxis>
                        <e-chart-chartarea>
                            <e-chartarea-border width="0"></e-chartarea-border>
                        </e-chart-chartarea>
                        <e-series-collection>
                            <e-series dataSource="@ViewBag.SplineChartData" xName="day" width="3"
                                      yName="income" name="Income" type="@Syncfusion.EJ2.Charts.ChartSeriesType.Line">
                                <e-series-marker visible="true" width="8" height="8" shape="Circle"></e-series-marker>
                            </e-series>
                            <e-series dataSource="@ViewBag.SplineChartData" xName="day" width="3"
                                      yName="expense" name="Expense" type="@Syncfusion.EJ2.Charts.ChartSeriesType.Line">
                                <e-series-marker visible="true" width="8" height="8" shape="Circle"></e-series-marker>
                            </e-series>
                        </e-series-collection>
                        <e-chart-legendsettings position="Top" alignment="Far" toggleVisibility="false">
                            <e-legendsettings-textstyle color="#1e293b" size="1rem"></e-legendsettings-textstyle>
                        </e-chart-legendsettings>
                        <e-chart-tooltipsettings enable shared></e-chart-tooltipsettings>
                    </ejs-chart>
                </div>
            </div>
        </div>
    </div>

    @*Recent Transactions*@
    <div class="dashboard-section">
        <h5 class="dashboard-section-title">Recent Transactions</h5>
        <div class="row">
            <div class="col-md-12">
                <div class="widget">
                    <ejs-grid id="recent-transactions"
                    dataSource="@ViewBag.RecentTransactions" gridLines="None">
                        <e-grid-columns>
                            <e-grid-column headerText="Category" field="CategoryTitleWithIcon"></e-grid-column>
                            <e-grid-column headerText="Date" field="Date" type="date" format="MMM-dd-yy"></e-grid-column>
                            <e-grid-column headerText="Amount" field="FormattedAmount" textAlign="Right"></e-grid-column>
                        </e-grid-columns>
                    </ejs-grid>
                </div>
            </div>
        </div>
    </div>
</div>